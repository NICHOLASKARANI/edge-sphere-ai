# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/edgesphere

# MQTT
MQTT_BROKER_HOST=mqtt.edgesphere.ai
MQTT_BROKER_PORT=8883
MQTT_USERNAME=device_client
MQTT_PASSWORD=secure_password

# AI/ML
ANOMALY_DETECTION_MODEL_PATH=/models/anomaly_detection.h5
PREDICTIVE_MAINTENANCE_MODEL_PATH=/models/predictive_maintenance.pkl

# Security
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256